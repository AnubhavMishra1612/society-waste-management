# SocietyClean Environment Template
# Duplicate this file to .env and supply actual development secrets

# Application Server
PORT=4000
NODE_ENV=development
CLIENT_URL=http://localhost:3000

# Authentication & Security
JWT_SECRET=development_jwt_secret_change_me_to_random_32_characters_in_prod
JWT_EXPIRES_IN=7d
COOKIE_SECRET=development_cookie_secret_string

# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/societyclean_dev

# File & Image Storage ('local' or 's3')
STORAGE_DRIVER=local
LOCAL_UPLOAD_PATH=./uploads
MAX_FILE_SIZE_BYTES=5242880 # 5MB

# S3 Configuration (Optional for production)
S3_BUCKET_NAME=
S3_REGION=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000 # 15 minutes
RATE_LIMIT_MAX_REQUESTS=100
