# SocietyClean Environment Template
# Duplicate this file to .env and supply actual development secrets

# Application Server
PORT=4000
NODE_ENV=development
CLIENT_URL=http://localhost:3000

# Frontend API URL Configuration (Vite)
# Leave empty for same-origin serverless deployment (Vercel) or local dev proxy (http://localhost:3000 -> localhost:4000)
# Set to remote API origin if Express backend is hosted externally (e.g., https://societyclean-api.onrender.com)
VITE_API_URL=

# Authentication & Security
JWT_SECRET=development_jwt_secret_change_me_to_random_32_characters_in_prod
JWT_EXPIRES_IN=7d
COOKIE_SECRET=development_cookie_secret_string

# Database
# For SQLite (default): Leave empty for automatic path (data/societyclean.db locally, /tmp/societyclean.db on Vercel)
# Or specify an explicit path:
DATABASE_PATH=./data/societyclean.db

# File & Image Storage ('local' or 's3')
STORAGE_DRIVER=local
LOCAL_UPLOAD_PATH=./uploads
MAX_FILE_SIZE_BYTES=5242880 # 5MB

# S3 Configuration (Optional for production)
S3_BUCKET_NAME=
S3_REGION=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000 # 15 minutes
RATE_LIMIT_MAX_REQUESTS=100
